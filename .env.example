# Copy to .env (or run ./scripts/init-env.sh to generate one with random secrets).
# Never commit .env.

# ---- PostgreSQL ----
POSTGRES_USER=syncspace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=syncspace
POSTGRES_HOST_PORT=5432
# Used by `npm run dev` / `npm run migrate:dev` on the host. Containers get their own URL from docker-compose.yml.
DATABASE_URL=postgres://syncspace:change-me@localhost:5432/syncspace

# ---- Redis (Phase 3) ----
REDIS_PASSWORD=change-me
REDIS_HOST_PORT=6379
# Used by `npm run dev` / tests on the host. Containers get their own URL from docker-compose.yml.
REDIS_URL=redis://:change-me@localhost:6379/0

# ---- API ----
# Number of API instances behind the web proxy (Phase 3: horizontal scaling).
API_REPLICAS=2
# Must be at least 32 random characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
LOG_LEVEL=info
# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# ---- Frontend ----
WEB_HOST_PORT=5173
